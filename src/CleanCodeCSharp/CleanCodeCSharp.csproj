<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- "dotnet run" starts the "User Self Service" (Clean/Uss) -->
    <StartupObject>CleanCodeCSharp.Clean.Uss.Dev</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Allows the test project to access "internal" members (C#'s counterpart of Java's package-private) -->
    <InternalsVisibleTo Include="CleanCodeCSharp.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Database of the "User Self Service" (Clean/Uss): SQLite, nothing to install -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11"/>
  </ItemGroup>

</Project>
